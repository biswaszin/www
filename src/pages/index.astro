---
import Layout from "../layouts/Layout.astro";
import Globe from "../components/Globe.astro";
---

<Layout title="bsws" globe={false}>
  <section class="hero-section">
    <div class="container">
      <div class="hero-personal">
        <div class="hero-id">
          <h1 class="hero-name">[ Ankit Biswas ]</h1>

          <ul class="hero-links">
            <li>
              <a href="https://github.com/biswaszin">github</a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/biswaszin/">linkedin</a>
            </li>

            <!--<li>
              <p> to change into dark theme, click on the avatar </p>
            </li>-->
          </ul>
        </div>

        <!-- Fixed bottom-left on desktop; sits beside the name on phones. -->
        <Globe hero />
      </div>

      <div class="hero-text">
        <p class="hero-content">
          Hi! I'm <span>Ankit Biswas</span> (alias. biswaszin) Your favourite
          cat whisperer, I <span>love</span> cats. 
          <br />
          I am learning bit of networking. And honestly a bit of everything the
          tech side has to offer.

          Read Under Doctor (manga) please. 

        </p>
      </div>
    </div>
  </section>
</Layout>
