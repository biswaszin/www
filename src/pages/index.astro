---
import Layout from "../layouts/Layout.astro";
import Globe from "../components/Globe.astro";
---

<Layout title="bsws" globe={false}>
  <section class="hero-section">
    <div class="container">
      <div class="hero-personal">
        <div class="hero-id">
          <h1 class="hero-name">[ Ankit Biswas ]</h1>

          <ul class="hero-links">
            <li>
              <a href="https://github.com/biswaszin">github</a>
            </li>
            <li>
              <a href="https://www.linkedin.com/in/biswaszin/">linkedin</a>
            </li>

            <!--<li>
              <p> to change into dark theme, click on the avatar </p>
            </li>-->
          </ul>
        </div>

        <!-- Fixed bottom-left on desktop; sits beside the name on phones. -->
        <Globe hero />
      </div>

      <div class="hero-text">
        <p class="hero-content">
          hi! i'm <span>Ankit Biswas</span> (alias. biswaszin) your favourite
          cat whisperer, i <span>love</span> cats.
          <br><br>
          will be working on a gallery and blog once my end sems are over.
          <br><br>
          i am learning networking. And honestly a bit of everything the
          tech side has to offer. also people from <a class="text-block" href="https://threadlocked.xyz">threadlocked.xyz</a> inspired me a lot.
          along with my sweet adorable cute <br>[ cool friends ] and my dear girlfriend. 
          <br><br>
          to whoever reading this from the other side of the internet, i hope you're as happy as i am. let's learn and improve together.
          <br><br>
          thank you, and have a nice day (or night)!
        </p>
      </div>
    </div>
  </section>
</Layout>
