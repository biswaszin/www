---
import Layout from "../layouts/Layout.astro";
import Globe from "../components/Globe.astro";
---

<Layout title="Ankit Biswas" globe={false}>
  <section class="hero-section">
    <div class="container">
      <div class="hero-personal">
        <div class="hero-id">
          <h1 class="hero-name">[ Ankit Biswas ]</h1>

          <ul class="hero-links">
            <li>
              <a class="text-block" href="https://github.com/biswaszin">
                github
              </a>
            </li>
            <li>
              <a
                class="text-block"
                href="https://www.linkedin.com/in/biswaszin/"
              >
                linkedin
              </a>
            </li>

            <!--<li>
              <p> to change into dark theme, click on the avatar </p>
            </li>-->
          </ul>
        </div>

        <!-- Fixed bottom-left on desktop; sits beside the name on phones. -->
        <Globe hero />
      </div>

      <div class="hero-text">
        <p class="hero-content">
          hi! i'm <span>Ankit Biswas</span> (alias. biswaszin) your favourite
          cat whisperer, i <span>love</span> cats. i use{" "}
          <a class="text-block" href="https://neovim.io">
            neovim
          </a>{" "}
          btw.
          <br />
          <br />
          will be working on a gallery and blog once my end sems are over.
          <br />
          <br />
          currently, i am learning networking. and honestly everything that can
          make a computer tick. <br /> <br />
          the ridiculously talented nerds from{" "}
          <a class="text-block" href="https://threadlocked.xyz">
            threadlocked.xyz
          </a>{" "}
          and the crazy folks from{" "}
          <a class="text-block" href="https://www.youtube.com/@IAmManware">
            manware
          </a>{" "}
          discord, inspired me a lot, even if they don't know it.
          <br />
          <br />
          and of course, my sweet, adorable, cute,{" "}
          <a class="text-block" href="/friends">
            cool friends
          </a>{" "}
          and my dear <a class="text-block">girlfriend</a> who make life a whole
          lot better.
          <br />
          <br />
          to whoever is reading this from the other side of the internet, i hope
          you're as happy as i am. let's learn and improve together.
          <br />
          <br />
          thank you, and have a nice day (or night)!
        </p>
      </div>
    </div>
  </section>
</Layout>
