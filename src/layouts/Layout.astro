---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Globe from "../components/Globe.astro";
import ViewCounter from "../components/ViewCounter.astro";
import { STATES, CAT_THEME } from "../themes.js";
import { GLYPH_SETS, fontVar } from "../globeGlyphs.js";
import { Font } from "astro:assets";
import { ONEKO } from "../features.js";
const {
  title = "Ankit Biswas",
  description = "hi! i'm Ankit Biswas (aka biswaszin), your favourite cat whisperer. learning networking and everything that makes a computer tick.",
  globe = true,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.jpg", Astro.site);
const isCatsPage = Astro.url.pathname.replace(/\/+$/, "") === "/cats";
// Fonts for the globe's extra scripts. Their @font-face rules carry a
// unicode-range, so each one only downloads once its script is on screen.
const globeFontVars = GLYPH_SETS.filter((set) => set.font).map((set) => fontVar(set.font));
---

<!doctype html>
<html lang="en" class={isCatsPage ? "theme-cat" : undefined}>
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Ankit Biswas" />
    <link rel="canonical" href={canonicalURL} />
    <!-- Open Graph / link previews (LinkedIn, Discord, WhatsApp, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ankit Biswas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Diwali sparks glowing orange against the night" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Self-hosted fonts (configured in astro.config.mjs). Only the body
         font is preloaded; the others download when something uses them. -->
    <Font cssVariable="--font-mono" preload={[{ subset: "latin", weight: 400 }]} />
    <Font cssVariable="--font-display" />
    {globeFontVars.map((v) => <Font cssVariable={v} />)}
    <link rel="icon" href="/favicon/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <!-- Apply the saved theme before first paint so page changes don't flash.
         The /cats page is themed by html.theme-cat instead. -->
    {!isCatsPage && (
      <script is:inline define:vars={{ STATES, CAT_THEME }}>
        try {
          const states =
            sessionStorage.getItem("catThemeUnlocked") === "true"
              ? [...STATES, CAT_THEME]
              : STATES;
          const v = parseInt(localStorage.getItem("themeIndex"), 10);
          const s = states[v >= 0 && v < states.length ? v : 0];
          const root = document.documentElement;
          root.style.setProperty("--primary-color", s.bg);
          root.style.setProperty("--secondary-color", s.fg);
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <Navbar />
    <slot />
    {globe && <Globe />}
    <ViewCounter />
    <!-- oneko cursor-chasing cat (black cat, white outline); toggle in src/features.js -->
    {ONEKO && <script is:inline src="/oneko.js" data-cat="/images/oneko-blackcat.png"></script>}
  </body>
</html>
