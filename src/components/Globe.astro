---
// Spinning ASCII globe: a disc of shuffling mixed-script glyphs where land is
// drawn bold and sea is drawn faint, with a blinking pin on Kolkata.
// Clicking it cycles through the glyph sets in src/globeGlyphs.js (default ->
// hindi -> bengali), remembered for the tab session. `hero` marks the home-page
// instance that flows under the links, beside the body text.
import { GLYPH_SETS, fontVar } from "../globeGlyphs.js";

const { hero = false } = Astro.props;
// Font stack for the scripts JetBrains Mono lacks; the browser picks the right
// one per character, so mixed scripts mid-ripple still render.
const wideFont = [
  ...GLYPH_SETS.filter((set) => set.font).map((set) => `var(${fontVar(set.font)})`),
  "sans-serif",
].join(", ");
---

<div
  class:list={["globe", { "globe--hero": hero }]}
  role="button"
  tabindex="0"
  aria-label="Globe: switch letters"
  style={`--globe-wide-font: ${wideFont}`}
>
  <pre class="globe-grid" aria-hidden="true"></pre>
  <div class="globe-label" aria-hidden="true"><span></span></div>
</div>

<style>
  .globe {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 1;
    /* Room for the clock caption directly under the disc. */
    padding-bottom: 22px;
    font-size: 8px;
    user-select: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  /* Home-page instance: flows under the name and links, in the left column next
     to the body text, instead of floating in the page corner. */
  .globe--hero {
    position: relative;
    left: auto;
    bottom: auto;
    width: fit-content;
    margin-top: 1.25rem;
    font-size: clamp(10px, 1.25vw, 13.5px);
  }

  /* The grid is rebuilt every frame. If a press landed on a glyph element that
     is replaced before release, the browser drops the click, so only the
     stable .globe root receives pointer events. */
  .globe-grid,
  .globe-label {
    pointer-events: none;
  }

  .globe:focus-visible {
    outline: 1px dashed var(--secondary-color);
    outline-offset: 4px;
  }

  .globe :global(span) {
    font-style: normal;
  }

  /* Indic letters are wider than the 0.6em mono cell, so each glyph gets its own
     fixed-width box and is drawn slightly smaller: the disc keeps its shape. */
  .globe-grid :global(.w) {
    /* em here is the shrunken 0.8em size, so 0.75em wide x 1.25 tall equals
       the parent's 0.6em x 1em mono cell exactly. */
    display: inline-block;
    width: 0.75em;
    height: 1.25em;
    overflow: visible;
    text-align: center;
    vertical-align: top;
    font-family: var(--globe-wide-font);
    font-style: normal;
    font-size: 0.8em;
    line-height: 1.25;
  }

  .globe-grid {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1em;
    line-height: 1;
    font-style: normal;
    color: color-mix(in srgb, var(--secondary-color) 38%, transparent);
  }

  .globe-grid :global(b) {
    font-weight: 700;
    color: var(--secondary-color);
  }

  .globe-grid :global(.globe-pin) {
    display: inline-block;
    width: 0.6em;
    text-align: center;
    font-weight: 700;
    color: var(--secondary-color);
    transform: scale(2.2);
    animation: globe-blink 1s steps(1, end) infinite;
  }

  /* Caption centred under the disc, inside the globe's reserved padding. */
  .globe-label {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
  }

  /* The clock's colon blinks with the pin (toggled from the script). */
  .globe-label.is-blink :global(.globe-colon) {
    visibility: hidden;
  }

  .globe-label span {
    display: block;
    font-size: 14px;
    line-height: 1.2;
    padding: 0 3px;
    white-space: nowrap;
    font-family: var(--font-mono), var(--globe-wide-font);
    color: var(--secondary-color);
    background: var(--primary-color);
  }

  @keyframes globe-blink {
    50% {
      visibility: hidden;
    }
  }

  @media (max-width: 900px) {
    .globe {
      display: none;
    }

    /* Phones: the hero globe returns to its compact spot beside the name. */
    .globe--hero {
      display: block;
      margin-top: 0;
      padding-bottom: 16px;
      flex-shrink: 0;
      font-size: clamp(4px, 1.55vw, 6.5px);
    }

    /* And the caption is just the city, not the clock. */
    .globe--hero .globe-label span {
      font-size: 11px;
    }
  }

  /* Narrow phones: scale the globe with the name so both fit side by side. */
  @media (max-width: 430px) {
    .globe--hero {
      font-size: clamp(3.5px, 1.3vw, 5.5px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-grid :global(.globe-pin) {
      animation: none;
    }
  }
</style>

<script>
  import { GLYPH_SETS } from "../globeGlyphs.js";

  // 120x60 equirectangular land bitmask (3° cells, row 0 = 90°N, col 0 = 180°W),
  // rasterized from Natural Earth 1:110m land via world-atlas@2.0.2.
  const MASK_B64 =
    "";
  const MW = 120;
  const MH = 60;
  const MASK = Uint8Array.from(atob(MASK_B64), (ch) => ch.charCodeAt(0));
  const isLand = (lat: number, lon: number) => {
    const x = (((Math.floor((lon + 180) / 3) % MW) + MW) % MW);
    const y = Math.min(MH - 1, Math.max(0, Math.floor((90 - lat) / 3)));
    const i = y * MW + x;
    return (MASK[i >> 3] >> (i & 7)) & 1;
  };

  const SETS = GLYPH_SETS.map((set) => ({
    ...set,
    chars: Array.from(set.glyphs),
  }));
  const glyph = (set: number) => {
    const chars = SETS[set].chars;
    return chars[(Math.random() * chars.length) | 0];
  };

  const STORAGE_KEY = "globeScript";
  const loadMode = () => {
    try {
      const id = sessionStorage.getItem(STORAGE_KEY);
      return Math.max(0, SETS.findIndex((set) => set.id === id));
    } catch (e) {
      return 0;
    }
  };
  const saveMode = (mode: number) => {
    try {
      sessionStorage.setItem(STORAGE_KEY, SETS[mode].id);
    } catch (e) {}
  };

  const ROWS = 22;
  const COLS = 37; // ≈ ROWS / 0.6 so the disc is round in a 0.6em-wide mono font
  const TILT = 0.3; // radians the north pole leans toward the viewer
  const SPEED = 15; // degrees per second
  const FPS = 12;
  const SHUFFLE = 0.12; // share of glyphs swapped each frame
  const RIPPLE_MS = 800; // time for a script change to sweep the whole disc
  const PIN = { lat: 22.57, lon: 88.36 }; // Kolkata
  const D = Math.PI / 180;
  const cosT = Math.cos(TILT);
  const sinT = Math.sin(TILT);
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const mobileGlobe = matchMedia("(max-width: 900px)");

  // Kolkata time for the pin label, 24-hour, in each script's own digits.
  const clocks = SETS.map(
    (set) =>
      new Intl.DateTimeFormat("en-GB", {
        timeZone: "Asia/Kolkata",
        hour: "2-digit",
        minute: "2-digit",
        hourCycle: "h23",
        numberingSystem: set.numerals ?? "latn",
      })
  );
  const kolkataTime = (set: number, now: Date) => {
    const parts = clocks[set].formatToParts(now);
    const part = (type: string) => parts.find((p) => p.type === type)?.value ?? "";
    return `${part("hour")}<span class="globe-colon">:</span>${part("minute")}`;
  };

  // Per-cell geometry is fixed; only the centre longitude changes.
  type Cell = { lat: number; dLon: number } | null;
  const cells: Cell[] = [];
  for (let r = 0; r < ROWS; r++) {
    for (let c = 0; c < COLS; c++) {
      const x = ((c + 0.5) * 2) / COLS - 1;
      const y = 1 - ((r + 0.5) * 2) / ROWS;
      const z2 = 1 - x * x - y * y;
      if (z2 < 0) {
        cells.push(null);
        continue;
      }
      const z = Math.sqrt(z2);
      const yw = y * cosT + z * sinT;
      const zw = -y * sinT + z * cosT;
      cells.push({ lat: Math.asin(yw) / D, dLon: Math.atan2(x, zw) / D });
    }
  }

  function pinCell(lon0: number) {
    const phi = PIN.lat * D;
    const lam = (PIN.lon - lon0) * D;
    const xw = Math.cos(phi) * Math.sin(lam);
    const yw = Math.sin(phi);
    const zw = Math.cos(phi) * Math.cos(lam);
    const y = yw * cosT - zw * sinT;
    const z = yw * sinT + zw * cosT;
    if (z < 0.2) return null;
    return {
      r: Math.min(ROWS - 1, Math.floor(((1 - y) / 2) * ROWS)),
      c: Math.min(COLS - 1, Math.floor(((xw + 1) / 2) * COLS)),
    };
  }

  function mount(root: HTMLElement) {
    const grid = root.querySelector<HTMLElement>(".globe-grid")!;
    const label = root.querySelector<HTMLElement>(".globe-label")!;
    const labelText = label.querySelector("span")!;
    let labelHtml = "";

    let mode = loadMode();
    const script: number[] = cells.map(() => mode); // glyph set index per cell
    const chars = cells.map((cell) => (cell ? glyph(mode) : " "));
    const switchAt = new Float64Array(cells.length); // when each cell flips script
    let lon0 = PIN.lon;
    let pin: { r: number; c: number } | null = null;

    const setAria = () =>
      root.setAttribute(
        "aria-label",
        `Globe: switch letters to ${SETS[(mode + 1) % SETS.length].id}`
      );
    setAria();

    function draw() {
      pin = pinCell(lon0);
      let html = "";
      for (let r = 0; r < ROWS; r++) {
        let bold = false;
        for (let c = 0; c < COLS; c++) {
          const i = r * COLS + c;
          const cell = cells[i];
          const land = !!cell && !!isLand(cell.lat, cell.dLon + lon0);
          if (land !== bold) {
            html += land ? "<b>" : "</b>";
            bold = land;
          }
          if (pin && pin.r === r && pin.c === c) {
            html += '<span class="globe-pin">◉</span>';
          } else if (cell && SETS[script[i]].font) {
            html += '<i class="w">' + chars[i] + "</i>";
          } else {
            html += chars[i];
          }
        }
        if (bold) html += "</b>";
        html += "\n";
      }
      grid.innerHTML = html;

      const now = new Date();
      // Phones show just the city under the small globe; desktop shows the clock.
      const text = mobileGlobe.matches
        ? SETS[mode].label
        : `${SETS[mode].label} ${kolkataTime(mode, now)}`;
      // Rewrite only when the text changes (each minute, or on a script switch).
      if (text !== labelHtml) {
        labelText.innerHTML = text;
        labelHtml = text;
      }
      // Colon off for the second half of every second, like the pin.
      label.classList.toggle("is-blink", !reduceMotion && now.getMilliseconds() >= 500);
    }

    // Flip every cell whose ripple time has passed to the current mode.
    function applyRipple(now: number) {
      for (let i = 0; i < cells.length; i++) {
        if (cells[i] && script[i] !== mode && now >= switchAt[i]) {
          script[i] = mode;
          chars[i] = glyph(mode);
        }
      }
    }

    function next() {
      mode = (mode + 1) % SETS.length;
      saveMode(mode);
      setAria();
      // Ripple outward from Kolkata if it's on screen, else from the centre.
      const or = pin ? pin.r + 0.5 : ROWS / 2;
      const oc = pin ? pin.c + 0.5 : COLS / 2;
      const dist = (i: number) =>
        Math.hypot(((i % COLS) + 0.5 - oc) * 0.6, Math.floor(i / COLS) + 0.5 - or);
      let max = 0;
      for (let i = 0; i < cells.length; i++) if (cells[i]) max = Math.max(max, dist(i));
      const now = performance.now();
      const span = reduceMotion ? 0 : RIPPLE_MS;
      for (let i = 0; i < cells.length; i++) {
        switchAt[i] = now + (dist(i) / max) * span;
      }
      if (reduceMotion) {
        applyRipple(now);
        draw();
      }
    }

    root.addEventListener("click", next);
    root.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        next();
      }
    });

    if (reduceMotion) {
      draw();
      // No animation loop here, so refresh the clock on its own.
      setInterval(draw, 15_000);
      return;
    }

    let start = 0;
    let last = 0;
    const startLon = PIN.lon + 120; // Kolkata rotates into view shortly after load
    function tick(now: number) {
      if (!start) start = now;
      if (now - last >= 1000 / FPS) {
        last = now;
        for (let i = 0; i < chars.length; i++) {
          if (cells[i] && Math.random() < SHUFFLE) chars[i] = glyph(script[i]);
        }
        applyRipple(now);
        // Lowering the centre longitude moves land left-to-right, as Earth spins.
        lon0 = startLon - ((now - start) / 1000) * SPEED;
        draw();
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  document.querySelectorAll<HTMLElement>(".globe").forEach(mount);
</script>
